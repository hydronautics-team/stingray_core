<?xml version="1.0"?>
<package format="3">
  <name>stingray_core_localization</name>
  <version>0.1.0</version>
  <description>State estimation for Stingray underwater vehicles.</description>
  <maintainer email="p.v.elesin@gmail.com">Pavel Elesin</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>dvl_msgs</depend>
  <depend>vectornav_msgs</depend>

  <depend>tf2</depend>

  <exec_depend>robot_localization</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
